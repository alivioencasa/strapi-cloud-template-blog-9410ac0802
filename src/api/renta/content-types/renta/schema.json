{
  "kind": "collectionType",
  "collectionName": "rentas",
  "info": {
    "singularName": "renta",
    "pluralName": "rentas",
    "displayName": "Renta"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fechaEntrega": {
      "type": "datetime"
    },
    "fechaDevolucion": {
      "type": "datetime"
    },
    "estadoEquipoEntrega": {
      "type": "enumeration",
      "enum": [
        "Nuevo",
        "Bueno",
        "Regular",
        "Dañado"
      ]
    },
    "estadoEquipoDevolucion": {
      "type": "enumeration",
      "enum": [
        "Nuevo",
        "Bueno",
        "Regular",
        "Dañado"
      ]
    },
    "observacionesEntrega": {
      "type": "string",
      "required": true
    },
    "observacionesDevolucion": {
      "type": "string"
    },
    "cargosDanos": {
      "type": "decimal"
    },
    "fotoEntrega": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "fotoDevolucion": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "orden": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::orden.orden",
      "inversedBy": "rentas"
    },
    "inventario": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::inventario.inventario",
      "inversedBy": "rentas"
    },
    "estadoRenta": {
      "type": "enumeration",
      "enum": [
        "pendiente_entrega",
        "entregada",
        "devuelta",
        "completada",
        "danos_pendientes"
      ],
      "default": "pendiente_entrega"
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente"
    }
  }
}
