      "enum": [
        "Pendiente",
        "Pagado",
        "Cancelado",
        "Reembolsado",
        "Fallido"
      ]
    },
    "metodoPago": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
