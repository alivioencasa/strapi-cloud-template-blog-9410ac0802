{
  "kind": "collectionType",
  "collectionName": "inventarios",
  "info": {
    "singularName": "inventario",
    "pluralName": "inventarios",
    "displayName": "Inventario"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "identificador": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "estado": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "enum": [
        "Disponible",
        "Rentado",
        "Mantenimiento",
        "Transito",
        "No disponible"
      ]
    },
    "detalles": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "regex": "notas sobre la condición específica del equipo"
    },
    "articulo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::articulo.articulo",
      "inversedBy": "inventarios"
    },
    "orden": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::orden.orden",
      "inversedBy": "inventario"
    }
  }
}
